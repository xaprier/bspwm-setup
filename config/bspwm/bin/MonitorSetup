#!/bin/sh
# =============================================================
# Script Name: MonitorSetup
# Description: Dynamic multi-monitor configuration for bspwm using xrandr
# Features:
#   - Auto-detect connected monitors (Up to 4 monitors)
#   - Respects an already-configured primary monitor (nvidia-settings,
#     xorg.conf, or a manual `xrandr --primary`), falling back to the
#     first detected output if none is set
#   - Dynamic workspace assignment
#   - Resolution/refresh rate detection
#
# Author: gh0stzk
# Repo:   https://github.com/gh0stzk/dotfiles
# Date:   24.04.2025
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

# xrandr cmd
XRANDR_OUTPUT=$(xrandr)

# Function to obtain monitor info (POSIX-compliant)
get_monitor_info() {
    echo "$XRANDR_OUTPUT" | awk -v monitor="$1" '
        $1 == monitor { getline; print $1, $2 }
    ' | tr -d '*+'
}

set -- $(echo "$XRANDR_OUTPUT" | grep -E ' connected' | awk '{print $1}')

NUM_MONITORS=$#

# Main case for monitor configuration
case $NUM_MONITORS in
    0)
        echo "Warning: No connected monitors detected"
        ;;

    1)
        monitor_1="$1"
        set -- $(get_monitor_info "$monitor_1")
        mode_1="$1"
        rate_1="$2"

        xrandr --output "$monitor_1" --primary --mode "$mode_1" --pos 0x0 --auto --rate "$rate_1"
        bspc monitor "$monitor_1" -d 1 2 3 4 5 6
        ;;

    2)
        monitor_1="$1"
        monitor_2="$2"

        echo "Detected monitors: $monitor_1, $monitor_2"

        set -- $(get_monitor_info "$monitor_1")
        mode_1="$1"
        rate_1="$2"

        set -- $(get_monitor_info "$monitor_2")
        mode_2="$1"
        rate_2="$2"

        # set the HDMI-* one as primary and the other one to the left of it with correct workspaces
        case "$monitor_1" in
            HDMI-*)
                primary_monitor="$monitor_1"
                secondary_monitor="$monitor_2"
                primary_mode="$mode_1"
                secondary_mode="$mode_2"
                primary_rate="$rate_1"
                secondary_rate="$rate_2"
                ;;
            *)
                primary_monitor="$monitor_2"
                secondary_monitor="$monitor_1"
                primary_mode="$mode_2"
                secondary_mode="$mode_1"
                primary_rate="$rate_2"
                secondary_rate="$rate_1"
                ;;
        esac

        echo "Setting $primary_monitor as primary and $secondary_monitor to the left of it"
        echo "Primary monitor: $primary_monitor ($primary_mode @ $primary_rate Hz)"
        echo "Secondary monitor: $secondary_monitor ($secondary_mode @ $secondary_rate Hz)"

        xrandr --output "$primary_monitor" --primary --mode "$primary_mode" --pos 0x0 --auto --rate "$primary_rate" \
               --output "$secondary_monitor" --mode "$secondary_mode" --left-of "$primary_monitor" --auto --rate "$secondary_rate"

        bspc monitor "$secondary_monitor" -d 5 6 7 8
        bspc monitor "$primary_monitor" -d 1 2 3 4
        bspc wm -O "$primary_monitor" "$secondary_monitor"
        ;;

    *)
        echo "Warning: Configuration not supported for more than 4 monitors"
        ;;
esac
