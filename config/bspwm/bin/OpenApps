WIDGET_DIR="$HOME/.config/bspwm/eww"

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--filemanager)
			thunar
		;;
	--browser)
			zen-browser
		;;
	--editor)
			zeditor
		;;
	--telegram)
		telegram-desktop
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		eww -c "$WIDGET_DIR" open --toggle csheet
		;;
	--usercard)
		eww -c "$WIDGET_DIR" open --toggle launchermenu
		;;
	--player)
		MediaGUI
		;;
	--cava)
		Term --cava
		;;
	--config)
		code ~/.config/bspwm
		;;
	*)
		echo "Invalid Option"
		;;
esac
