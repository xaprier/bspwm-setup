# ----- Applications ----- #
############################

# ----- Main Apps ----- #

# Open Terminal (Normal & Floating)
super + {_,alt + }Return
    OpenApps --{terminal,floating}

# App launcher
super + d
    OpenApps --menu

# Theme Selector
alt + @space
    RiceSelector

# ----- Your Apps ----- #

# Apps (browser, editor, filemanager, config, pavucontrol, terminal)
super + {F1,F2,F3,F4,s,enter}
    OpenApps --{browser,filemanager,editor,config,soundcontrol,terminal}

# Rice Editor App
super + r
    RiceEditor

# Wallpaper selector
super + w
    WallSelect

# Network Manager
super + alt + n
    OpenApps --netmanager

# Bluetooth
super + alt + b
    OpenApps --bluetooth

# Clipboard
super + v
    OpenApps --clipboard

# Screenshot
alt + s
    OpenApps --screenshot

# PowerMenu
super + p
    OpenApps --powermenu

# Rofi style
super + alt + l
    RofiLauncher --choose-style

# ----- Environment Apps ----- #

# jgmenu
~button3
    win=$(xdotool getmouselocation --shell | sed -n 's/^WINDOW=\(.*\)/\1/p'); \
    type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null); \
    case "$type" in *DESKTOP*) \
        jgmenu_run ;; esac

# Power off, Reboot, Log out, Lockscreen, kill an app
ctrl + super + alt + {p,r,q,l,k,s}
    {systemctl poweroff, systemctl reboot,bspc quit,ScreenLocker,xkill}

# Hide/Show Bar (Polybar and/or eww)
super + alt + {h,u}
    HideBar {-h,-u}

# Change transparency on focused window
ctrl + alt + {plus,minus,t}
    picom-trans {-c -3,-c +3,-c -d}

# Manage brightness
XF86MonBrightness{Up,Down}
    sh Brightness {up,down}

# Volume control
XF86Audio{RaiseVolume,LowerVolume,Mute}
    Volume{ --inc, --dec, --toggle}

# Music Control
XF86Audio{Next,Prev,Play,Stop}
    MediaControl {--next,--previous,--toggle,--stop}

#####################
# ----- Bspwm ----- #
#####################

# Reload BSPWM
super + shift + r
    bspc wm -r

super + alt + r
    SoftReload

# Close/Kill node
super + q
    bspc node -{c,k}

# Reload sxhkd Keybinds
super + Escape
    pkill -USR1 -x sxhkd; dunstify -u low -i ~/.config/bspwm/config/assets/reload.svg 'sxhkd' 'The configuration file has been reloaded successfully!'

# ----- Node states and flags ----- #

super + t
    bspc query -N -n focused.pseudo_tiled && bspc node -t floating || bspc node -t pseudo_tiled

super + shift + f
    bspc query -N -n focused.fullscreen && bspc node -t tiled || bspc node -t fullscreen

super + @space
    bspc query -N -n focused.floating && bspc node -t tiled || bspc node -t floating

# Hide window
super + h
    HideNode --hide

# Show menu to restore hidden windows
alt + h
    HideNode --menu

# ----- Focus/Swap Nodes ----- #

# Rotate desktop
ctrl + Tab
    bspc node @/ --rotate {90,-90}

# Switch workspace
super + alt + {Left,Right}
    bspc desktop -f {prev,next}

# Focus or send to the given desktop
super + {_,ctrl + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# Send focused Node to workspace directionally
super + ctrl + {Left,Right}
    bspc node -d {prev,next} '--follow'

# Node switcher
alt + Tab
    rofi \
        -theme $HOME/.config/bspwm/config/rofi-themes/Windows.rasi \
        -show window -window-thumbnail \
        -window-hide-active-window true \
        -kb-accept-entry "!Alt-Tab,Return" \
        -kb-element-next "Alt-Tab"

# Swap Nodes
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

# Focus Nodes
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# ----- Move/Resize Nodes ----- #

# increase/decrease Node
super + alt + {plus,minus}
    { \
       bspc node -z top_right 20 -20 ; bspc node -z bottom_left -20 20; \
    ,  bspc node -z top_right -20 20 ; bspc node -z bottom_left 20 -20; \
    }

# increase/decrease FLOATING node size (zoom in/out)
super + ctrl + {plus,minus}
    { \
	xdotool getactivewindow windowmove --relative -- -50 -25 ; xdo resize -w +100 -h +50; \
	, xdotool getactivewindow windowmove --relative -- +50 +25 ; xdo resize -w -100 -h -50; \
    }

# Move floating window
super + shift + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# move and focus the node to the given desktop
super + {_,shift + }{1-9,0}
    bspc {desktop -f, node -d} '^{1-9,10}' --follow

# ----- Multi operation functions ----- #
# Close all nodes in current desktop
super + ctrl + x
    bspc query -N -d | xargs -I id -n 1 bspc node id -c

# Close/Kill all unfocused local windows
super + n ; {x,k}
    bspc query -N -n '.!focused.!marked.local.window' | xargs -I id -n 1 bspc node id {-c,-k}

# Bring all marked windows to the focused desktop
super + n ; m
    bspc query -N -n '.marked' | xargs -I id -n 1 bspc node id -d focused --follow

# Bring everything from desktop X to the current desktop
# Example usage: super + n followed by 5 (brings everything from desktop 5)
super + n ; {1-9}
    bspc query -N -d {1-9} -n '.window' | xargs -I id -n 1 bspc node id -d focused
